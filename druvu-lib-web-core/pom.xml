<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.druvu</groupId>
		<artifactId>druvu-lib-web</artifactId>
		<version>2.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>druvu-lib-web-core</artifactId>

	<name>DRUVU.COM / LIB / WEB / CORE</name>

	<description>Core implementation for druvu-lib-web</description>

	<dependencies>
		<!-- API module -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-web-api</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- druvu-lib-loader -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-loader</artifactId>
			<version>${druvu-lib-loader.version}</version>
		</dependency>

		<!-- slf4j-api (logging facade; loader no longer leaks it transitively) -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>

		<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- JETTY — the embedded server, only the slices core uses.   -->
		<!-- No annotation scanning, JNDI, CDI or ASM: that chain is   -->
		<!-- excluded below. jetty-ee10-webapp stays only because the   -->
		<!-- websocket server module `requires transitive` it (JPMS);  -->
		<!-- nothing in core uses WebAppContext or web.xml.            -->
		<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- Server, ServerConnector, HttpConfiguration, ErrorHandler (brings jetty-http/io/util) -->
		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-server</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- LoginService, Authenticator, IdentityService — the auth adapter -->
		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-security</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- ServletContextHandler, ServletHolder, DefaultServlet — the servlet container -->
		<dependency>
			<groupId>org.eclipse.jetty.ee10</groupId>
			<artifactId>jetty-ee10-servlet</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Required at module level by jetty-ee10-websocket-jetty-server; core itself never uses it -->
		<dependency>
			<groupId>org.eclipse.jetty.ee10</groupId>
			<artifactId>jetty-ee10-webapp</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Jetty WebSocket server. Its pom pulls jetty-ee10-annotations (and with it plus, JNDI, CDI,
		     interceptor, transaction, ASM) for WAR-style auto-configuration; its module-info does not
		     require it, and core configures WebSocket programmatically, so the chain is excluded. -->
		<dependency>
			<groupId>org.eclipse.jetty.ee10.websocket</groupId>
			<artifactId>jetty-ee10-websocket-jetty-server</artifactId>
			<version>${jetty.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.eclipse.jetty.ee10</groupId>
					<artifactId>jetty-ee10-annotations</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- spotbugs-annotations (also used by lombok generated code) -->
		<dependency>
			<groupId>com.github.spotbugs</groupId>
			<artifactId>spotbugs-annotations</artifactId>
			<version>4.10.4</version>
			<scope>provided</scope>
		</dependency>

		<!-- TEST: the dispatcher is tested through the one template engine that ships. It is found by
		     ServiceLoader at boot and never referenced from a test, exactly as an application sees it. -->
		<dependency>
			<groupId>com.druvu</groupId>
			<artifactId>druvu-lib-web-php</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<!-- GSON -->
		<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- Tests compile and run on the classpath, as the example app runs. The wiring tests drive the booted
			     server with the JDK's HTTP and WebSocket clients (java.net.http), which this module does not read, and
			     the compiler plugin's own module arguments override an extra add-reads. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<useModulePath>false</useModulePath>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven-surefire-plugin.version}</version>
				<configuration>
					<useModulePath>false</useModulePath>
					<properties>
						<property>
							<name>usedefaultlisteners</name>
							<value>false</value>
						</property>
					</properties>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
