# Supply-chain guards for every npm command run here: by the Maven build, by Renovate, by hand.
# Dependencies' install scripts never run: the way a compromised package usually runs its code.
ignore-scripts=true
# Only versions published more than 3 days ago: most poisoned releases are pulled within hours.
min-release-age=3
# Packages come from the registry only, never from a git URL.
allow-git=none

# package.json names the exact version in use, as package-lock.json does; no ^ ranges.
save-exact=true
# No funding appeals in the build log.
fund=false
